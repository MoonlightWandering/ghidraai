# ============================================================
# Ghidra-AI Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.

# --- Ghidra ---
# Path to your local Ghidra installation (e.g., /opt/ghidra_11.3)
# Leave empty to use DEMO mode with sample decompiled code.
GHIDRA_INSTALL_DIR=/opt/ghidra

# --- Paritok Compression ---
# API key for the hosted Paritok endpoint
PARITOK_API_KEY=
# URL for the Paritok compression API. Leave empty for mock/passthrough mode.
PARITOK_API_URL=https://api.paritok.com/v1/compress

# --- LLM Provider ---
# Choose: "groq" or "openai"
LLM_PROVIDER=groq

# Groq API key (for llama-3.3-70b-versatile)
GROQ_API_KEY=

# OpenAI API key (fallback)
OPENAI_API_KEY=

# --- Server ---
HOST=0.0.0.0
PORT=8000
